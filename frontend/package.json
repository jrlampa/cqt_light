{
  "name": "cqt-light",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "vite build && npm run build:electron",
    "build:electron": "node scripts/build-standalone.cjs",
    "dist": "npm run build && node scripts/prepare-prod-package.cjs && electron-builder && node scripts/restore-package.cjs",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5174 && electron .\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "build": {
    "appId": "com.im3.cqtlight",
    "productName": "CQT Light",
    "copyright": "Copyright © 2026 IM3 Brasil",
    "directories": {
      "output": "dist_electron",
      "buildResources": "build_resources"
    },
    "files": [
      "dist/**/*",
      "electron_obfuscated/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../scripts/dist",
        "to": "python_bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../data",
        "to": "data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build_resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CQT Light",
      "installerIcon": "build_resources/icon.png",
      "uninstallerIcon": "build_resources/icon.png",
      "installerHeaderIcon": "build_resources/icon.png"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.1.1",
    "electron-is-dev": "^3.0.1",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.3.4",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^10.0.2",
    "eslint-plugin-security": "^4.0.0",
    "fs-extra": "^11.3.3",
    "globals": "^17.3.0",
    "happy-dom": "^20.5.0",
    "javascript-obfuscator": "^5.3.0",
    "postcss": "^8.4.49",
    "pyinstaller": "^0.0.1",
    "tailwindcss": "^3.4.17",
    "terser": "^5.46.0",
    "vite": "^6.4.1",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.0.18",
    "wait-on": "^8.0.3"
  }
}
